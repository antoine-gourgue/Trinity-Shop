// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  // Adresse confirmée par le lien envoyé à l'inscription ; sans confirmation, aucun e-mail commercial
  emailVerified DateTime?
  phone         String?   @unique
  password      String
  birthDate     DateTime?
  role          Role      @default(Customer)
  carts         Cart[]
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]

  // Carte Trinity (programme de fidélité)
  loyaltyNumber       String? // unicité vérifiée à la création de la carte
  loyaltyPoints       Int                  @default(0)
  loyaltyJoinedAt     DateTime?
  loyaltyTransactions LoyaltyTransaction[]
  favorites           Favorite[]
  cartReminders       Boolean              @default(true) // accepte les rappels de panier abandonné
  favoritePromos      Boolean              @default(true) // accepte les alertes quand un favori passe en promotion
  // Magasin choisi par le client : drive de retrait et point de départ des livraisons
  storeId             String?
  store               Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String               @id @default(cuid())
  name             String
  price            Int
  regularPrice     Int? // prix barré quand le produit est en promotion
  netContent       String? // contenance OpenFoodFacts, ex. « 540 g »
  hidden           Boolean              @default(false) // retiré du catalogue (pas de photo officielle) ; la fiche reste accessible depuis les commandes
  description      String
  picture          String
  barCode          BigInt               @unique
  nutriScore       nutriScore?
  brand            Brand                @relation(fields: [brandId], references: [id])
  brandId          String
  categories       CategoriesProducts[]
  // Ancien stock unique, remplacé par le stock de chaque magasin (table à supprimer après la migration)
  legacyStock      Stock?
  stocks           StoreStock[]
  cartsWithProduct ProductInCart[]
  promoEndsAt      DateTime? // fin de la promotion : le prix revient alors au prix barré
  favorites        Favorite[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
}

model Category {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  products    CategoriesProducts[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CategoriesProducts {
  product      Product  @relation(fields: [productId], references: [id])
  productId    String
  category     Category @relation(fields: [categoryName], references: [name])
  categoryName String
  assignedAt   DateTime @default(now())

  @@id([productId, categoryName])
}

// Ancien stock unique du drive, remplacé par StoreStock : plus utilisé par le site, gardé le temps
// de la migration (prisma/split-stock-by-store.ts) pour ne pas interrompre la version en ligne
model Stock {
  id        String   @id @default(cuid())
  quantity  Int
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id             String          @id @default(cuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  productsInCart ProductInCart[]
  orders         Order[]
  archived       Boolean         @default(false)
  reminderSentAt DateTime? // dernier rappel « panier abandonné » envoyé
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProductInCart {
  id              String   @id @default(cuid())
  quantity        Int
  cart            Cart     @relation(fields: [cartId], references: [id])
  cartId          String
  product         Product  @relation(fields: [productId], references: [id])
  productId       String
  // Produit équivalent accepté si celui-ci manque à la préparation
  allowSubstitute Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  type      AddressType
  street    String
  city      String
  zipCode   String
  country   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[] @relation("BillingAddress")
  shippingOrders Order[] @relation("ShippingAddress")
}

model Order {
  id                  String               @id @default(cuid())
  userId              String
  cartId              String
  billingAddressId    String?
  shippingAddressId   String?
  validated           Boolean              @default(false)
  status              OrderStatus          @default(received)
  stockDeducted       Boolean              @default(false) // stock décompté à la commande (commandes passées après ce suivi)
  stripeSessionId     String?              @unique // paiement Stripe à l'origine de la commande : une session ne crée qu'une commande
  pickupSlot          DateTime? // début du créneau de retrait au drive (créneaux d'une heure)
  loyaltyDiscount     Int                  @default(0) // remise Carte Trinity, en millièmes d'euro
  loyaltyPointsUsed   Int                  @default(0)
  loyaltyPointsEarned Int                  @default(0)
  loyaltyTransactions LoyaltyTransaction[]
  // Magasin qui prépare la commande (drive de retrait, ou départ de la livraison)
  storeId             String?
  store               Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  billingAddress  Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])

  // Remplissage des créneaux de chaque drive
  @@index([storeId, pickupSlot])
}

enum AddressType {
  domicile
  livraison
}

enum Role {
  Admin
  Seller
  Customer
}

enum nutriScore {
  A
  B
  C
  D
  E
  unknown
}

// Mouvement de points Carte Trinity : positif quand des points sont gagnés, négatif quand ils sont utilisés
model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  points    Int
  label     String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Suivi d'une commande au drive
enum OrderStatus {
  received // reçue
  preparing // en préparation
  ready // prête au retrait, ou partie en livraison
  completed // retirée ou livrée
  cancelled // annulée
}

// Produits mis de côté par un client
model Favorite {
  userId          String
  productId       String
  createdAt       DateTime  @default(now())
  // Alerte « favori en promotion » déjà envoyée pour la promotion en cours ; remise à zéro quand elle se termine
  promoNotifiedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
}

// Compteur de tentatives par clé (connexion, inscription, mot de passe oublié) sur une fenêtre de temps
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Magasin Trinity : drive de retrait et point de départ des livraisons. Le catalogue, les prix
// et le stock sont communs à tous les magasins.
model Store {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String // « Trinity Nantes Beaujoire »
  street    String
  zipCode   String
  city      String
  region    String
  latitude  Float
  longitude Float
  phone     String?
  hours     String // horaires du drive, ex. « Lun.–sam. 8h30–20h30 »
  users     User[]
  orders    Order[]
  stocks    StoreStock[]
  createdAt DateTime     @default(now())

  @@index([city])
}

// Stock d'un produit dans un magasin : chaque drive a le sien, décompté par ses commandes
model StoreStock {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  // Ruptures et stocks faibles d'un magasin (back-office)
  @@index([storeId, quantity])
  @@index([productId])
}

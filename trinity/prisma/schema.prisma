// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  // Adresse confirmée par le lien envoyé à l'inscription ; sans confirmation, aucun e-mail commercial
  emailVerified DateTime?
  phone         String?   @unique
  password      String
  birthDate     DateTime?
  role          Role      @default(Customer)
  carts         Cart[]
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]

  // Carte Trinity (programme de fidélité)
  loyaltyNumber       String? // unicité vérifiée à la création de la carte
  loyaltyPoints       Int                  @default(0)
  loyaltyJoinedAt     DateTime?
  loyaltyTransactions LoyaltyTransaction[]
  favorites           Favorite[]
  cartReminders       Boolean              @default(true) // accepte les rappels de panier abandonné
  favoritePromos      Boolean              @default(true) // accepte les alertes quand un favori passe en promotion
  // Magasin choisi par le client : drive de retrait et point de départ des livraisons.
  // Pour un compte magasin (StoreManager), le magasin qu'il gère.
  storeId             String?
  store               Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String               @id @default(cuid())
  name             String
  price            Int
  regularPrice     Int? // prix barré quand le produit est en promotion
  netContent       String? // contenance OpenFoodFacts, ex. « 540 g »
  hidden           Boolean              @default(false) // retiré du catalogue (pas de photo officielle) ; la fiche reste accessible depuis les commandes
  description      String
  picture          String
  barCode          BigInt               @unique
  nutriScore       nutriScore?
  brand            Brand                @relation(fields: [brandId], references: [id])
  brandId          String
  categories       CategoriesProducts[]
  stocks           StoreStock[]
  // Durée de conservation habituelle, en jours : date proposée à la réception, fenêtre anti-gaspi
  shelfLifeDays    Int                  @default(180)
  stockLots        StockLot[]
  restockOrders    RestockOrder[]
  cartsWithProduct ProductInCart[]      @relation("CartLines")
  substitutedIn    ProductInCart[]      @relation("Substitutes")
  promoEndsAt      DateTime? // fin de la promotion : le prix revient alors au prix barré
  favorites        Favorite[]
  prospectusItems  ProspectusItem[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
}

model Category {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  products    CategoriesProducts[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CategoriesProducts {
  product      Product  @relation(fields: [productId], references: [id])
  productId    String
  category     Category @relation(fields: [categoryName], references: [name])
  categoryName String
  assignedAt   DateTime @default(now())

  @@id([productId, categoryName])
}

model Cart {
  id             String          @id @default(cuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  productsInCart ProductInCart[]
  orders         Order[]
  archived       Boolean         @default(false)
  reminderSentAt DateTime? // dernier rappel « panier abandonné » envoyé
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProductInCart {
  id                String          @id @default(cuid())
  quantity          Int
  cart              Cart            @relation(fields: [cartId], references: [id])
  cartId            String
  product           Product         @relation("CartLines", fields: [productId], references: [id])
  productId         String
  // Produit équivalent accepté si celui-ci manque à la préparation
  allowSubstitute   Boolean         @default(true)
  // Préparation en magasin : quantité réellement prélevée (null tant que l'article n'est pas traité)
  preparedQuantity  Int?
  // Produit équivalent donné pour la quantité manquante, si le client l'accepte
  substituteId      String?
  substitute        Product?        @relation("Substitutes", fields: [substituteId], references: [id])
  // Offre anti-gaspi choisie par le client : unités à date courte d'un lot du magasin
  antiGaspiLotId    String?
  antiGaspiLot      StockLot?       @relation("AntiGaspiOffers", fields: [antiGaspiLotId], references: [id], onDelete: SetNull)
  // Lots dont viennent les unités servies (traçabilité)
  lotAllocations    LotAllocation[]
  // Unités servies à prix anti-gaspi et remise de la ligne (millièmes d'euro), fixées à la commande
  antiGaspiQuantity Int             @default(0)
  antiGaspiDiscount Int             @default(0)
  // Prix unitaire payé (millièmes d'euro), fixé à la commande : promotions et prospectus peuvent
  // ensuite changer le prix du produit. Null pour un panier en cours et les commandes plus anciennes.
  unitPrice         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  type      AddressType
  street    String
  city      String
  zipCode   String
  country   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[] @relation("BillingAddress")
  shippingOrders Order[] @relation("ShippingAddress")
}

model Order {
  id                   String               @id @default(cuid())
  userId               String
  cartId               String
  billingAddressId     String?
  shippingAddressId    String?
  validated            Boolean              @default(false)
  status               OrderStatus          @default(received)
  stockDeducted        Boolean              @default(false) // stock décompté à la commande (commandes passées après ce suivi)
  stripeSessionId      String?              @unique // paiement Stripe à l'origine de la commande : une session ne crée qu'une commande
  pickupSlot           DateTime? // début du créneau de retrait au drive (créneaux d'une heure)
  loyaltyDiscount      Int                  @default(0) // remise Carte Trinity, en millièmes d'euro
  loyaltyPointsUsed    Int                  @default(0)
  loyaltyPointsEarned  Int                  @default(0)
  loyaltyTransactions  LoyaltyTransaction[]
  // Fin de la préparation en magasin, et montant alors remboursé (articles manquants, remplaçants
  // moins chers), en millièmes d'euro
  preparedAt           DateTime?
  preparationRefund    Int                  @default(0)
  // Suivi en magasin : début de la préparation, arrivée du client au drive (et sa place), remise
  preparationStartedAt DateTime?
  arrivedAt            DateTime?
  parkingSpot          Int?
  completedAt          DateTime?
  // Remise anti-gaspi (articles à date courte), en millièmes d'euro
  antiGaspiDiscount    Int                  @default(0)
  // Magasin qui prépare la commande (drive de retrait, ou départ de la livraison)
  storeId              String?
  store                Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  billingAddress  Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])

  // Remplissage des créneaux de chaque drive
  @@index([storeId, pickupSlot])
}

enum AddressType {
  domicile
  livraison
}

enum Role {
  Admin // siège : back-office de tout le réseau
  Seller
  Customer
  StoreManager // compte d'un magasin : back-office de ce seul magasin (User.storeId)
}

enum nutriScore {
  A
  B
  C
  D
  E
  unknown
}

// Mouvement de points Carte Trinity : positif quand des points sont gagnés, négatif quand ils sont utilisés
model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  points    Int
  label     String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Suivi d'une commande au drive
enum OrderStatus {
  received // reçue
  preparing // en préparation
  ready // prête au retrait, ou partie en livraison
  completed // retirée ou livrée
  cancelled // annulée
}

// Produits mis de côté par un client
model Favorite {
  userId          String
  productId       String
  createdAt       DateTime  @default(now())
  // Alerte « favori en promotion » déjà envoyée pour la promotion en cours ; remise à zéro quand elle se termine
  promoNotifiedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
}

// Compteur de tentatives par clé (connexion, inscription, mot de passe oublié) sur une fenêtre de temps
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Magasin Trinity : drive de retrait et point de départ des livraisons. Le catalogue, les prix
// et le stock sont communs à tous les magasins.
model Store {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String // « Trinity Nantes Beaujoire »
  street        String
  zipCode       String
  city          String
  region        String
  latitude      Float
  longitude     Float
  phone         String?
  hours         String // horaires du drive, ex. « Lun.–sam. 8h30–20h30 »
  users         User[]
  orders        Order[]
  stocks        StoreStock[]
  stockLots     StockLot[]
  restockOrders RestockOrder[]
  prospectuses  Prospectus[]
  createdAt     DateTime       @default(now())

  @@index([city])
}

// Lot d'un produit dans un magasin : unités reçues ensemble, avec la même date limite. Le stock du
// magasin (StoreStock) est la somme de ses lots ouverts. Les clients reçoivent les dates les plus
// longues ; à l'approche de la date, le lot passe en anti-gaspi, puis le reste est donné ou jeté.
model StockLot {
  id               String          @id @default(cuid())
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Unités restantes, et unités reçues
  quantity         Int
  initialQuantity  Int
  // Date limite de consommation (DLC) ou de durabilité (DDM), au jour près
  bestBefore       DateTime        @db.Date
  // Jours avant la date où le lot passe en anti-gaspi (selon la durée de conservation du produit)
  markdownDays     Int             @default(5)
  soldQuantity     Int             @default(0)
  donatedQuantity  Int             @default(0)
  wastedQuantity   Int             @default(0)
  // Unités retirées par une correction d'inventaire (rayon vide à la préparation, comptage)
  adjustedQuantity Int             @default(0)
  // Date passée : le lot est retiré de la vente (il ne compte plus dans le stock) et attend d'être jeté
  withdrawnAt      DateTime?
  // Lot clos : tout est parti, ou le reste a été donné ou jeté
  closedAt         DateTime?
  receivedAt       DateTime        @default(now())
  // Réassort dont vient le lot
  restockOrderId   String?         @unique
  restockOrder     RestockOrder?   @relation(fields: [restockOrderId], references: [id], onDelete: SetNull)
  offeredInCarts   ProductInCart[] @relation("AntiGaspiOffers")
  allocations      LotAllocation[]
  createdAt        DateTime        @default(now())

  @@index([storeId, productId, closedAt])
  @@index([storeId, closedAt, bestBefore])
  @@index([productId])
  // Table d'origine des lots anti-gaspi, devenus les lots de tout le stock : la garder évite de casser
  // la version en ligne pendant la migration
  @@map("AntiGaspiLot")
}

// Unités d'un lot servies pour une ligne de commande : traçabilité (rappel d'un lot) et retour au
// bon lot si la commande est annulée
model LotAllocation {
  id        String        @id @default(cuid())
  lineId    String
  line      ProductInCart @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lotId     String
  lot       StockLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime      @default(now())

  @@index([lineId])
  @@index([lotId])
}

enum RestockStatus {
  ordered // commandé, en livraison
  received // réceptionné : un lot est entré en stock
  cancelled
}

// Commande de réassort d'un magasin : livrée le lendemain, elle devient un lot à la réception
model RestockOrder {
  id               String        @id @default(cuid())
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int
  status           RestockStatus @default(ordered)
  // Passée automatiquement sous le seuil de stock faible
  automatic        Boolean       @default(false)
  orderedAt        DateTime      @default(now())
  expectedAt       DateTime
  receivedAt       DateTime?
  receivedQuantity Int?
  lot              StockLot?

  @@index([storeId, status, expectedAt])
  @@index([storeId, productId, status])
}

// Stock d'un produit dans un magasin : chaque drive a le sien, décompté par ses commandes
model StoreStock {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  // Ruptures et stocks faibles d'un magasin (back-office)
  @@index([storeId, quantity])
  @@index([productId])
}

// Prospectus d'un magasin : des produits à prix promo pour les clients de ce magasin, entre deux dates
model Prospectus {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  // Minuit (heure de Paris) le premier jour, et minuit après le dernier jour (fin exclusive)
  startsAt    DateTime
  endsAt      DateTime
  // Brouillon tant qu'il n'est pas publié ; publié, ses prix s'appliquent de startsAt à endsAt
  publishedAt DateTime?
  items       ProspectusItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([storeId, endsAt])
}

model ProspectusItem {
  id           String     @id @default(cuid())
  prospectusId String
  prospectus   Prospectus @relation(fields: [prospectusId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Prix promo dans le magasin, en millièmes d'euro
  price        Int

  @@unique([prospectusId, productId])
  @@index([productId])
}

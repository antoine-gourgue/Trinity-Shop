# Copier ce fichier en .env.local et remplir les valeurs (ne jamais commiter .env.local)

# PostgreSQL : URL avec pool de connexions (requêtes de l'application) et URL directe (prisma db push)
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/trinity"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/trinity"

# Clé de signature des sessions NextAuth et des liens envoyés par e-mail (désinscription, confirmation d'adresse) : générer avec `openssl rand -base64 32`
# (AUTH_SECRET est accepté à la place, comme sur Vercel)
NEXTAUTH_SECRET=""

# Facultatif : e-mails envoyés par Resend (bienvenue et confirmation d'adresse, commandes, suivi, mot de passe oublié, rappels de panier, alertes promo).
# Sans clé, rien n'est envoyé ; en développement, le lien de réinitialisation s'affiche dans la console du serveur.
RESEND_API_KEY=""
# Facultatif : autre expéditeur, sur un domaine validé dans le compte Resend de la clé (par défaut "Trinity <no-reply@trinity.antoinegourgue.dev>")
EMAIL_FROM=""

# Facultatif : URL publique du site (liens des e-mails, URL canoniques, Open Graph, sitemap.xml, robots.txt), ex. https://shop.example.com
# À défaut : le domaine de production Vercel (VERCEL_PROJECT_PRODUCTION_URL), sinon http://localhost:3000
APP_URL=""

# Mot de passe du compte administrateur créé par `npx prisma db seed` (12 caractères au moins)
SEED_ADMIN_PASSWORD=""

# Facultatif : paiement par carte via Stripe (clé de test sk_test_…) ; sans clé, le paiement reste simulé
STRIPE_SECRET_KEY=""
# Facultatif : secret du webhook Stripe (whsec_…), pour créer la commande même si le client ne revient pas sur le site
STRIPE_WEBHOOK_SECRET=""

# Secret de la tâche planifiée nocturne (/api/cron/maintenance) : Vercel l’ajoute à ses appels
CRON_SECRET=""
